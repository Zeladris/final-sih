{
  "name": "@kisansetu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/integration",
    "seed": "tsx src/scripts/seed.ts",
    "seed:fixtures": "tsx tests/fixtures/seedFixtures.ts",
    "verify": "tsx src/scripts/verifySetup.ts",
    "provision": "tsx src/scripts/provision.ts",
    "reset:storage": "tsx src/scripts/resetStorage.ts",
    "seed:demo": "tsx src/scripts/seedDemo.ts",
    "reset:demo": "tsx src/scripts/resetDemo.ts"
  },
  "dependencies": {
    "@kisansetu/shared": "*",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
