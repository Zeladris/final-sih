# ---------------------------------------------------------------------------
# KisanSetu / Procuremintra environment
# Copy to .env and fill in. NEVER commit the filled-in .env.
# ---------------------------------------------------------------------------

# --- Supabase (backend) ----------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# For `supabase start` locally this is http://127.0.0.1:54321
SUPABASE_URL=

# Publishable (or legacy anon) key. Safe to expose to browsers. Used for
# user-scoped clients that run under Row Level Security.
SUPABASE_ANON_KEY=

# Secret (or legacy service-role) key. SERVER ONLY.
# Never expose to the browser, never prefix with VITE_, never log it,
# never return it from an API.
SUPABASE_SERVICE_ROLE_KEY=

# --- API -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separate multiple trusted origins, e.g. a deployed frontend plus a
# preview URL: FRONTEND_URL=https://app.example.com,https://preview.example.com
FRONTEND_URL=http://localhost:5173

# Business timezone for procurement calendar dates. Do NOT use UTC.
APP_TIMEZONE=Asia/Kolkata

# Max farmer document upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# --- Frontend (Vite) -------------------------------------------------------
# These are compiled into the browser bundle. Only ever put public keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000

# --- AI quality service (optional). Unset = manual quality only.
# With `docker compose up` this is http://ml:8000; standalone it is 8001.
# In production, point this at the deployed ML service, e.g.
# ML_SERVICE_URL=https://quality-analysis-ml.onrender.com
# ML_SERVICE_URL=http://localhost:8001
# ML_TIMEOUT_MS=8000
# QUALITY_CONFIDENCE_THRESHOLD=0.75

# Weather context for the booking-time assessment. 'open-meteo' needs no key
# and sends coordinates only — never farmer identity. 'none' disables it, and
# the assessment then simply carries no weather caution.
# WEATHER_PROVIDER=open-meteo
# WEATHER_TIMEOUT_MS=4000

# Queue policy starting values (not claimed optima) — see apps/api/src/config/env.ts
# Weights sum to 1.0 before the penalty term; quality is deliberately the
# smallest signal, and never reorders fairness.
# QUEUE_QUALITY_WEIGHT=0.10
# QUEUE_MAX_WAIT_OVERRIDE_MINUTES=90
# QUEUE_RECALC_INTERVAL_SECONDS=60

# --- Bhashini (optional). Server-side ASR/TTS for voice booking (Phase 9), in
# English/Tamil/Kannada/Hindi/Malayalam. Unset = voice booking falls back to
# the browser's own speech engine (BrowserSpeechProvider), which is narrower
# language support but needs no key. Get userID/ulcaApiKey from
# https://bhashini.gov.in (MeitY auth). BHASHINI_PIPELINE_ID defaults to the
# public ASR+Translation+TTS pipeline used in Bhashini's own sample apps.
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_TIMEOUT_MS=15000

# --- Twilio (optional). Phone-call booking (Phase 9 IVR): a verified farmer
# calls in, and books a slot entirely with the keypad — no app, no data
# connection. Unset = the /api/ivr/voice webhook still runs (curl-testable)
# but never verifies Twilio's request signature, so only wire a real Twilio
# number to it once these are set. Get these from https://console.twilio.com
# after creating a (free trial) account and a phone number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Phase 8: payments. Only 'demo' exists; it moves NO money.
# PAYMENT_PROVIDER=demo
# PAYMENT_DEMO_SETTLE_SECONDS=5
# PAYMENT_STATUS_POLL_SECONDS=10
# A real provider adds its own secrets here (server-only, never VITE_):
# PAYMENT_API_URL=
# PAYMENT_CLIENT_ID=
# PAYMENT_CLIENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- apps/api/src/scripts/addMyPhoneAsFarmer.ts only (never read by the app
# itself) — a Supabase Personal Access Token, so that script can register a
# phone number as a fixed-OTP test number via the Management API instead of
# editing the Supabase Dashboard by hand. Generate one at
# https://supabase.com/dashboard/account/tokens. Optional: without it, the
# script still creates the farmer account, just skips the Test OTP update.
# SUPABASE_ACCESS_TOKEN=

# --- Automated tests only (never read by the app) ---------------------------
# Integration suites need the code your LOCAL test numbers accept
# (supabase/config.toml). Unset = those suites skip.
# TEST_OTP=
# Fixtures refuse any non-local Supabase. To use a throwaway remote project,
# name its host exactly. Never a real deployment.
# ALLOW_REMOTE_FIXTURES=xxxxxxxxxxxx.supabase.co

# --- Phase 12: admin analytics thresholds (policy, not claimed optima)
# ADMIN_HIGH_LOAD_QUEUE=10
# ADMIN_DELAYED_WAIT_MINUTES=60
# ADMIN_ALERT_AVG_WAIT_MINUTES=60
# ADMIN_ALERT_SLOT_DELAY_MINUTES=30
# ADMIN_ALERT_MANUAL_REVIEW_RATE=0.5
# ADMIN_ALERT_LOW_CONFIDENCE_RATE=0.5
# ADMIN_ALERT_CANCELLATION_RATE=0.3
# ADMIN_ALERT_MIN_SAMPLE=5
# ADMIN_RANKING_MIN_SAMPLE=3
# ADMIN_MAX_RANGE_DAYS=92
